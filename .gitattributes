# 保留 STEP 原件字节，避免换行转换破坏资产元数据中的 SHA256。
frontend/model-sources/*.step binary

# 原始交付依赖保持逐字节一致，避免 Windows 自动换行破坏来源哈希。
host/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
car/vendor/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# SRAM 位流与来源清单保留原始字节。
firmware/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
firmware/**/*.fs binary
